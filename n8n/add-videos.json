{
  "name": "StreamVault: add videos",
  "nodes": [
    {
      "parameters": {
        "content": "## StreamVault: add videos\n\nA web form (open it from *Add videos* → Production URL, and bookmark it on your phone). Each submit writes a .txt file of links into **OneDrive/StreamVault/queue/**; the PC queue worker picks it up on its next run.\n\nVideo files: drop them into the same queue/ folder from the OneDrive app.",
        "width": 460,
        "height": 260
      },
      "id": "899b9507-c1d4-53d2-859c-3089703d78cd",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -220,
        -200
      ]
    },
    {
      "parameters": {
        "formTitle": "StreamVault: add videos",
        "formDescription": "YouTube or Twitch links, one per line. The PC turns each into Shorts.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Links",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "https://www.youtube.com/watch?v=..."
            },
            {
              "fieldLabel": "Only this part",
              "placeholder": "optional, e.g. 1:00:00-2:30:00"
            }
          ]
        },
        "options": {}
      },
      "id": "2dbb103e-a52a-554f-9781-82c10717bf96",
      "name": "Add videos",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        200
      ],
      "webhookId": "453e3e3c-c194-5bab-87fe-66bbb3dae628"
    },
    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst urls = [...String(f['Links'] ?? '').matchAll(/https?:\\/\\/[^\\s\"'<>]+/g)]\n  .map(m => m[0].replace(/[).,;\\]]+$/, ''));\nif (!urls.length) throw new Error('No links found in the form');\nconst section = String(f['Only this part'] ?? '').trim();\nconst useSection = /^\\d[\\d:]*-\\d[\\d:]*$/.test(section);\nconst text = urls.map(u => (useSection ? `${u} --section ${section}` : u)).join('\\n') + '\\n';\nreturn [{ json: { name: `form-${$now.toFormat('yyyyLLdd-HHmmss')}.txt`, text, count: urls.length } }];\n"
      },
      "id": "2f9e312e-3404-50ff-9c3d-4c73919c9685",
      "name": "Build queue file",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://graph.microsoft.com/v1.0/me/drive/root:/StreamVault/queue/{{ $json.name }}:/content",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOneDriveOAuth2Api",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "={{ $json.text }}",
        "options": {}
      },
      "id": "f6e4594d-d42c-5571-b348-6e4e42a5a821",
      "name": "Write to OneDrive queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        200
      ]
    }
  ],
  "connections": {
    "Add videos": {
      "main": [
        [
          {
            "node": "Build queue file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build queue file": {
      "main": [
        [
          {
            "node": "Write to OneDrive queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
