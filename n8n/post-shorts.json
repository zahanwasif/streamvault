        0,
        400
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/drive/root:/StreamVault/ready:/children?$top=200",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOneDriveOAuth2Api",
        "options": {}
      },
      "id": "44225b2a-eabb-53fc-95ca-b06e87837d96",
      "name": "List ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Every folder waiting in ready/. Which one posts is decided in Build upload, from post.json.\nconst kids = $input.first().json.value ?? [];\nreturn kids\n  .filter(k => k.folder && !/^[._]/.test(k.name))\n  .slice(0, 200)\n  .map(k => ({ json: { folderId: k.id, folderName: k.name } }));\n"
      },
      "id": "bd8145eb-66e3-5f37-8915-aa7296deeb2c",
      "name": "Pick candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.microsoft.com/v1.0/me/drive/items/{{ $json.folderId }}/children",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOneDriveOAuth2Api",
        "options": {}
      },
      "id": "e916a231-ef48-521f-946c-59bb5e66493d",
      "name": "List files",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Keep folders that have post.json (the PC writes it last) and video.mp4. A result.json means the\n// Short was already uploaded but the move to posted/ failed: never upload it twice.\nconst out = [];\n$input.all().forEach((item, i) => {\n  const files = {};\n  for (const f of item.json.value ?? []) if (f.file) files[f.name] = f;\n  if (files['result.json'] || !files['post.json'] || !files['video.mp4']) return;\n  out.push({ json: {\n    ...$('Pick candidates').itemMatching(i).json,\n    postUrl: files['post.json']['@microsoft.graph.downloadUrl'],\n    videoUrl: files['video.mp4']['@microsoft.graph.downloadUrl'],\n    videoBytes: files['video.mp4'].size,\n  } });\n});\nreturn out;\n"
      },
      "id": "abbe3d01-0873-5f8a-b847-6abfc3273c8e",
      "name": "Choose post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.postUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "7559b79a-f448-5700-bffb-b0260c48a33f",
      "name": "Get post.json",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Settings\n// 'browser': upload through YouTube Studio on GitHub Actions (until Google's API audit is approved).\n// 'api': the YouTube Data API (public uploads need the audit).\nconst UPLOADER = 'browser';\nconst PRIVACY = 'public';      // api only: 'private' or 'unlisted' to post without going live\nconst CATEGORY_ID = '24';      // Entertainment\nconst LANGUAGE = 'en';\nconst PRIORITY_RANK = { high: 0, normal: 1, low: 2 };\n\n// Rank what's waiting: priority (set in the StreamVault app), then score, then oldest.\n// Skip Shorts on hold, and ones whose video is still syncing (smaller than the PC recorded).\nconst candidates = $input.all()\n  .map((item, i) => ({ pick: $('Choose post').itemMatching(i).json, post: item.json }))\n  .filter(({ pick, post }) => !post.hold && !(post.video_bytes && post.video_bytes !== pick.videoBytes))\n  .sort((a, b) =>\n    (PRIORITY_RANK[a.post.priority] ?? 1) - (PRIORITY_RANK[b.post.priority] ?? 1)\n    || (b.post.score ?? 0) - (a.post.score ?? 0)\n    || String(a.post.exported_at ?? a.pick.folderName).localeCompare(String(b.post.exported_at ?? b.pick.folderName)));\nif (!candidates.length) return [];\nconst { pick, post } = candidates[0];\n\n// YouTube rejects < and > in titles and descriptions.\nconst clean = (s, n) => {\n  s = String(s ?? '').replace(/</g, '‹').replace(/>/g, '›').trim();\n  return s.length <= n ? s : s.slice(0, n - 1).trimEnd() + '…';\n};\nconst bytes = s => new TextEncoder().encode(s).length;\nlet description = clean(post.description, 5000);\nwhile (bytes(description) > 5000) description = description.slice(0, -50);\nconst tags = [];\nfor (const t of post.tags ?? []) {\n  const v = String(t).replace(/^#/, '').trim();\n  if (v && !tags.includes(v) && [...tags, v].join(',').length <= 480) tags.push(v);\n}\nconst title = clean(post.title, 100);\nconst lang = post.language ?? LANGUAGE;\n// What the Studio uploader needs, as base64 JSON (a GitHub workflow input).\nconst studioPost = JSON.stringify({ id: pick.folderName, title, description, tags });\nconst postB64 = typeof Buffer !== 'undefined'\n  ? Buffer.from(studioPost, 'utf8').toString('base64')\n  : btoa(unescape(encodeURIComponent(studioPost)));\nreturn [{ json: {\n  ...pick,\n  uploader: UPLOADER,\n  postB64,\n  title,\n  priority: post.priority ?? 'normal',\n  score: post.score ?? null,\n  waiting: candidates.length,\n  request: {\n    snippet: { title, description, tags, categoryId: String(post.category_id ?? CATEGORY_ID),\n               defaultLanguage: lang, defaultAudioLanguage: lang },\n    status: { privacyStatus: PRIVACY, selfDeclaredMadeForKids: false, containsSyntheticMedia: false },\n  },\n} }];\n"
      },
