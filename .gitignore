# Media and per-run working data: large, and often other people's content
sources/*
shorts/*
inbox/*
!sources/.gitkeep
!shorts/.gitkeep
!inbox/.gitkeep
*.mp4
*.mov
*.mkv
*.webm
*.wav

# Queue worker state and logs
.worker/

# Secrets
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/

# OS / editor
Thumbs.db
.DS_Store
.vscode/
