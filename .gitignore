# Media and per-run working data: large, and often other people's content
sources/*
shorts/*
inbox/*
!sources/.gitkeep
!shorts/.gitkeep
!inbox/.gitkeep
*.mp4
*.mov
*.mkv
*.webm
*.wav

# Engine state and logs, and Shorts waiting for the app to upload them
.worker/
outbox/

# Desktop app
app/node_modules/
app/dist/

# Studio uploader: failure screenshots/HTML and saved sessions (as good as a password)
uploader/out/
*session*.b64

# Secrets
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/

# OS / editor
Thumbs.db
.DS_Store
.vscode/
